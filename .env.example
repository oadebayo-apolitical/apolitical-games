# Server-side only. Never exposed to the browser.
# Local dev: copy to .env.local and fill in. Vercel: set in Project Settings → Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...

# MongoDB Atlas connection string (global served-groups store). Optional:
# if unset, endless dedup degrades to no-op and the game still plays.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=apol-games
